# Backend database (Neon). Set this in Render as well.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Local source retained for migration only.
LOCAL_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/gift
# Migration target; same Neon connection string as DATABASE_URL.
NEON_DATABASE_URL=
FRONTEND_ORIGINS=https://your-app.vercel.app
